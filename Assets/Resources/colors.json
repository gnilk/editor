{
  "name": "Mariana",
  "author": "Gnilk, based on work by Sublime HQ Pty Ltd, Dmitri Voronianski",
  "variables":
  {
    "black": "hsl(0, 0%, 0%)",
    "blue": "hsl(210, 50%, 60%)",
    "blue-vibrant": "hsl(210, 60%, 60%)",
    "blue2": "hsla(210, 13%, 40%, 0.7)",
    "blue3": "hsl(210, 15%, 22%)",
    "blue4": "hsl(210, 15%, 25%)",
    "blue5": "hsl(180, 36%, 54%)",
    "blue6": "hsl(221, 12%, 69%)",
    "blue7": "hsl(180, 22%, 66%)",
    "blue8": "hsl(210, 30%, 72%)",
    "green": "hsl(114, 31%, 68%)",
    "grey": "hsl(0, 0%, 20%)",
    "grey2": "hsl(0, 0%, 40%)",
    "grey3": "hsl(0, 0%, 60%)",
    "grey4": "hsl(0, 0%, 80%)",
    "orange": "hsl(32, 93%, 66%)",
    "orange2": "hsl(32, 85%, 55%)",
    "orange3": "hsl(40, 94%, 68%)",
    "pink": "hsl(300, 30%, 68%)",
    "red": "hsl(357, 79%, 65%)",
    "red2": "hsl(13, 93%, 66%)",
    "white": "hsl(0, 0%, 100%)",
    "white2": "hsl(0, 0%, 97%)",
    "white3": "hsl(219, 28%, 88%)",
    "lilac": "hsl(260, 35%, 78%)",
    "selection_alpha" : "alpha(0.12)",
    "search_alpha" : "alpha(0.30)",
    "term_selection": "hsla(210, 40%, 50%, 0.25)"
  },
  "colors" : {
    "globals": {
      "unknown": "var(white3)",
      "foreground": "var(white3)",
      "caret": "var(orange)",
      "regular": "var(white3)",
      "background": "var(blue3)",
      "operator": "var(red2)",
      "keyword": "var(orange)",
      "known_type": "var(red)",
      "number": "var(blue-vibrant)",
      "string": "var(green)",
      "line_comment": "var(blue6)",
      "block_comment": "var(blue6)",
      "commented_text": "var(blue6)",
      "import": "var(blue5)",
      "preprocessor": "var(pink)",
      "macro_identifier": "var(orange3)",
      "heading": "var(orange)",
      "strong": "var(orange3)",
      "emphasis": "var(blue5)",
      "code": "var(green)",
      "list_marker": "var(red2)",
      "block_quote": "var(blue6)",
      "link": "var(blue)",
      "rule": "var(grey3)",
      "selection": "var(blue2)",
      "funky": "var(white3)"
    },
    "content": {
      "unknown": "var(white3)",
      "foreground": "var(white3)",
      "caret": "var(orange)",
      "regular": "var(white3)",
      "operator": "var(red2)",
      "keyword": "var(orange)",
      "known_type": "var(red)",
      "number": "var(blue-vibrant)",
      "string": "var(green)",
      "line_comment": "var(blue6)",
      "block_comment": "var(blue6)",
      "commented_text": "var(blue6)",
      "import": "var(blue5)",
      "preprocessor": "var(pink)",
      "macro_identifier": "var(orange3)",
      "heading": "var(orange)",
      "strong": "var(orange3)",
      "emphasis": "var(blue5)",
      "code": "var(green)",
      "list_marker": "var(red2)",
      "block_quote": "var(blue6)",
      "link": "var(blue)",
      "rule": "var(grey3)",
      "user_type": "var(blue5)",
      "function": "var(blue)",
      "member": "var(lilac)",
      "macro": "var(orange3)",
      "enum_value": "var(blue-vibrant)",
      "namespace": "var(grey4)",
      "library_type": "var(blue7)",
      "library_function": "var(blue8)",
      "selection": "color(var(orange),var(selection_alpha))",
      "search": "color(var(blue5),var(search_alpha))",
      "hexview": "var(grey3)",
      "funky": "var(white3)"
    },
    "ui": {
      "background": "var(blue3)",
      "foreground": "var(white3)",
      "gutter_background" : "var(blue4)",
      "gutter_foreground": "var(grey3)",
      "gutter_added": "var(green)",
      "gutter_modified": "var(orange3)",
      "gutter_deleted": "var(red)",
      "minimap_viewport": "hsla(0, 0%, 75%, 0.15)",
      "header_background": "var(blue4)",
      "header_foreground": "var(grey2)",
      "header_active_background": "var(grey)",
      "header_active_foreground": "var(white3)",
      "modal_background": "var(blue4)",
      "modal_foreground": "var(white3)",
      "tree_dimmed": "var(grey3)",
      "tree_modified": "var(orange3)",
      "tree_added": "var(green)",
      "tree_untracked": "var(green)",
      "tree_deleted": "var(red)",
      "tree_conflicted": "var(red2)"
    },
    "terminal": {
      "selection": "var(term_selection)",
      "0"  : "var(grey)",
      "1"  : "var(red)",
      "2"  : "var(green)",
      "3"  : "var(orange3)",
      "4"  : "var(blue)",
      "5"  : "var(pink)",
      "6"  : "var(blue5)",
      "7"  : "var(white3)",
      "8"  : "var(grey2)",
      "9"  : "var(red2)",
      "10" : "hsl(114, 40%, 76%)",
      "11" : "var(orange)",
      "12" : "var(blue8)",
      "13" : "var(lilac)",
      "14" : "var(blue7)",
      "15" : "var(white)"
    }
  }
}
