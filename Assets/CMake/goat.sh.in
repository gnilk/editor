#!/usr/bin/env bash
#
# GoatEdit command-line wrapper — GENERATED BY CMAKE, DO NOT EDIT.
# Source template: Assets/CMake/goat.sh.in   Install target: install-cli
#
# Launches through LaunchServices ('open') rather than running the bundle binary directly:
#  - the app is detached from the console (the prompt returns, closing the terminal won't kill it)
#  - the app is properly activated (frontmost, first in Cmd-Tab). A plain background launch gets
#    its activation refused by macOS' cooperative activation and lands last in Cmd-Tab.
# LaunchServices always starts the process in '/' with launchd's environment, so pass the shell's
# cwd (--cwd, must precede the file args) and PATH explicitly.
#
# -n: new instance even if one is already running (same as invoking the binary directly)
# -w / --wait: block until the editor exits. Use this for $EDITOR/$VISUAL (git commit, etc.):
#   export EDITOR="goat -w"
#
openArgs=(-n -a "@GEDIT_CLI_APP_PATH@" --env "PATH=$PATH")
if [[ "$1" == "-w" || "$1" == "--wait" ]]; then
    shift
    openArgs+=(-W)
fi

exec open "${openArgs[@]}" --args --cwd "$PWD" "$@"
