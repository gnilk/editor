void Parser::Feed(const uint8_t *data, size_t length) {
    for (size_t i = 0; i < length; i++) {
        Advance(data[i]);
    }
}

void Parser::Reset() {
    state = State::kGround;
    utf8Codepoint = 0;
    utf8Minimum = 0;
    utf8Remaining = 0;
    Clear();
    stringBuffer.clear();
    isStringOverflow = false;
    isStringTerminatorPending = false;
}

