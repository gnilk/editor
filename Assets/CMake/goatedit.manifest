<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  GoatEdit's Windows application manifest (docs/windows-port.md §4.3), embedded by the build:
  - activeCodePage UTF-8 (Windows 10 1903+): the process's ANSI code page is UTF-8, so a narrow string - every
    std::filesystem::path::string(), fopen, the C runtime - is UTF-8 as on unix, and no call site changes
  - dpiAwareness PerMonitorV2: sharp text on a scaled or second monitor (SDL3 reads the scale)
  - longPathAware: paths past 260 characters, where the system allows them
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
  <assemblyIdentity type="win32" name="com.gnilk.goatedit" version="0.2.0.0"/>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <asmv3:application>
    <asmv3:windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </asmv3:windowsSettings>
  </asmv3:application>
</assembly>
