#!/usr/bin/env bash
#
# GoatEdit command-line wrapper — GENERATED BY CMAKE, DO NOT EDIT.
# Source template: Assets/CMake/goat.sh.in   Install target: install-cli
#
# exec (not a plain call) so the shell process is replaced rather than forked —
# that keeps $EDITOR/$VISUAL usage (git commit, etc.) blocking until we exit.
#
exec "@GEDIT_CLI_APP_BINARY@" "$@"
